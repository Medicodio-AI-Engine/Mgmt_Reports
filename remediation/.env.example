# Environment overrides for the remediation platform.
# Every value here has a safe default in config/config.yaml; nothing in this file
# is required to run a dry run. Copy to .env only if you need to override.

# Source of truth for the daily management reports.
MGMT_REPORTS_REPOSITORY=Medicodio-AI-Engine/Mgmt_Reports
MGMT_REPORTS_DIRECTORY=Ai_Engr_Rpt/Daily/medicodio/Detail
MGMT_REPORTS_BRANCH=main

# Where run artifacts are written (relative paths resolve against the repo root).
ARTIFACT_ROOT_DIRECTORY=Ai_Engr_Rpt/Daily/medicodio/Remediation

# Playbook and capability registries.
PLAYBOOK_DIRECTORY=playbooks/org
GENERAL_PLAYBOOK_REGISTRY=playbooks/general
ORG_SKILL_REGISTRY=skills/registry.yaml

# Human review mechanism. FILE_DECISION_BLOCK = DECISION block committed into the
# stage artifact in this repository.
APPROVAL_MECHANISM=FILE_DECISION_BLOCK

# Keep this true for the pilot. Setting it false still writes nothing unless a
# repository is added to remediation_repository_allowlist in config/config.yaml.
DRY_RUN_MODE=true

# Optional: a directory holding local checkouts of the target repositories, read
# only, so a task description can state what the code looks like today. Unset
# means no code is inspected and the description says so.
# REPOSITORY_ROOT=/home/ubuntu/repos

# No secrets are needed for a dry run. Do not add credentials to this file.
