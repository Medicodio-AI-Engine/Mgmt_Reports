{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicodio.ai/schemas/remediation/stage_output.json",
  "title": "OUTPUT_DEVIN_AI stage document",
  "type": "object",
  "required": [
    "run_id",
    "stage",
    "status",
    "report_date",
    "dry_run",
    "issues",
    "next_state",
    "next_expected_input_file"
  ],
  "additionalProperties": true,
  "$defs": {
    "score": {
      "type": ["object", "null"],
      "required": ["score", "rationale", "factors", "confidence"],
      "additionalProperties": true,
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 10 },
        "rationale": { "type": "string" },
        "factors": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "properties": {
    "run_id": { "type": "string", "pattern": "^RUN_\\d{4}$" },
    "report_date": { "type": "string", "pattern": "^\\d{4}_\\d{2}_\\d{2}$" },
    "stage": { "type": "string" },
    "status": { "type": "string", "enum": ["OK", "PARTIAL_SOURCE_DATA", "BLOCKED", "NO_WORK", "ERROR"] },
    "dry_run": { "type": "boolean" },
    "run_flags": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "next_state": { "type": "string" },
    "next_expected_input_file": { "type": ["string", "null"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "issue_id", "attempt_id", "stage", "status", "next_state"],
        "additionalProperties": true,
        "properties": {
          "run_id": { "type": "string" },
          "issue_id": { "type": "string", "pattern": "^ISSUE_\\d{6}$" },
          "attempt_id": { "type": "string", "pattern": "^ISSUE_\\d{6}_ATTEMPT_\\d{2}$" },
          "stage": { "type": "string" },
          "status": { "type": "string" },
          "evidence": { "type": "array" },
          "source_references": { "type": "array" },
          "repository": { "type": ["string", "null"] },
          "branch": { "type": ["string", "null"] },
          "environment": { "type": ["string", "null"] },
          "category": { "type": ["string", "null"] },
          "security_classification": { "type": ["string", "null"] },
          "priority": { "$ref": "#/$defs/score" },
          "complexity": { "$ref": "#/$defs/score" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "playbook_match": { "type": ["object", "null"] },
          "skills_required": { "type": "array" },
          "skills_available": { "type": "array" },
          "missing_skills": { "type": "array" },
          "autonomy_tier": { "type": ["string", "null"], "enum": ["A", "B", "C", "D", null] },
          "stop_conditions": { "type": "array" },
          "proposed_action": { "type": ["string", "null"] },
          "implementation_plan": { "type": "array" },
          "changed_files": { "type": "array" },
          "commands_executed": { "type": "array" },
          "test_cases_generated": { "type": "array" },
          "test_results": { "type": "array" },
          "pre_fix_failure": { "type": ["boolean", "null"] },
          "post_fix_success": { "type": ["boolean", "null"] },
          "full_suite_result": { "type": ["string", "null"] },
          "commit_sha": { "type": ["string", "null"] },
          "pr_number": { "type": ["integer", "string", "null"] },
          "rollback_plan": { "type": ["string", "null"] },
          "human_review_result": { "type": ["string", "null"] },
          "reviewer_comments": { "type": "array" },
          "questions": { "type": "array" },
          "answers": { "type": "array" },
          "rejection_history": { "type": "array" },
          "guardrail_violations": { "type": "array" },
          "next_state": { "type": "string" },
          "next_expected_input_file": { "type": ["string", "null"] }
        }
      }
    }
  }
}
