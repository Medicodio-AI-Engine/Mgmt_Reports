{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicodio.ai/schemas/remediation/issue.json",
  "title": "Normalized issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "run_id",
    "attempt_id",
    "source",
    "source_reference",
    "source_provenance",
    "repository",
    "branch",
    "environment",
    "product",
    "component",
    "title",
    "description",
    "category",
    "defect_type",
    "security_scope",
    "files",
    "related_change",
    "evidence",
    "reproduction",
    "state",
    "confidence",
    "owner",
    "detected_at",
    "remediable"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "pattern": "^ISSUE_\\d{6}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN_\\d{4}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^ISSUE_\\d{6}_ATTEMPT_\\d{2}$"
    },
    "source": {
      "type": "string"
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "report_date",
          "report_type",
          "repository",
          "repository_path",
          "section",
          "member",
          "finding_reference",
          "evidence_excerpt_or_locator"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "report_date": {
            "type": "string",
            "pattern": "^\\d{4}_\\d{2}_\\d{2}$"
          },
          "report_type": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "repository_path": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "member": {
            "type": [
              "string",
              "null"
            ]
          },
          "finding_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_excerpt_or_locator": {
            "type": "string"
          }
        }
      }
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "product": {
      "type": [
        "string",
        "null"
      ]
    },
    "component": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "MISSING_TEST",
        "MECHANICAL_MIGRATION",
        "CI_FAILURE",
        "CODE_DEFECT",
        "SECURITY_TENANCY",
        "QA_FINDING",
        "REVIEW_FINDING",
        "CODE_QUALITY",
        "PROCESS_PRACTICE",
        "AUTOMATION_OPPORTUNITY",
        "UNKNOWN"
      ]
    },
    "defect_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "security_scope": {
      "type": "string",
      "enum": [
        "NONE",
        "UNKNOWN",
        "AUTHENTICATION",
        "AUTHORIZATION",
        "TENANT_ISOLATION",
        "PHI",
        "SECRETS",
        "BILLING"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_change": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "locator",
          "excerpt"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "REPORT_OBSERVATION",
              "REPOSITORY_VERIFIED_FACT",
              "INFERENCE",
              "RECOMMENDATION"
            ]
          },
          "locator": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "method",
        "notes"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "state": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "detected_at": {
      "type": "string"
    },
    "remediable": {
      "type": "string",
      "enum": [
        "CODE_CHANGE",
        "NON_CODE_PROCESS",
        "TOOLING_AUTOMATION",
        "UNKNOWN"
      ]
    },
    "candidate_repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corroborating_only": {
      "type": "boolean"
    },
    "environment_signal": {
      "type": "boolean"
    },
    "frequency": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "merged_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dedupe_signature": {
      "type": "string"
    },
    "corroboration": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis_scope": {
      "enum": [
        "IN_SCOPE",
        "OUT_OF_SCOPE",
        "UNRESOLVED"
      ]
    },
    "scope_reason": {
      "type": "string"
    },
    "reported_category": {
      "enum": [
        "BUG",
        "ENHANCEMENT"
      ]
    },
    "revised_category": {
      "enum": [
        "BUG",
        "ENHANCEMENT"
      ]
    },
    "category_match": {
      "type": "boolean"
    },
    "category_rationale": {
      "type": "string"
    },
    "task_description": {
      "type": "string"
    },
    "code_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkout_available": {
            "type": "boolean"
          },
          "present_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_file_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "work_done": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string"
              },
              "author": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commit_count": {
                "type": "integer"
              },
              "subjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "files_changed": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "insertions": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "deletions": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "history_available": {
                "type": "boolean"
              }
            },
            "required": [
              "date",
              "commit_count",
              "history_available"
            ]
          }
        },
        "required": [
          "repository",
          "checkout_available"
        ]
      }
    }
  }
}
